<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1711;CA1716;CA1822;CA1848;CA1873</NoWarn>
    <!-- 普通构建使用本仓库的契约快照；跨仓库测试显式指定 RouterHostRoot，避免加载两套 Contracts。 -->
    <RouterContractsProject Condition="'$(RouterContractsProject)' == '' and '$(RouterHostRoot)' != ''">$(RouterHostRoot)/src/Router.Contracts/Router.Contracts.csproj</RouterContractsProject>
    <RouterContractsProject Condition="'$(RouterContractsProject)' == ''">$(MSBuildThisFileDirectory)src/Router.Contracts/Router.Contracts.csproj</RouterContractsProject>
  </PropertyGroup>
</Project>
